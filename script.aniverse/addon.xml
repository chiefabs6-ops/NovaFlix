<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- AniVerse's tile under Video add-ons. Kodi starts a script straight away, so AniVerse opens without
     Kodi's folder screen first (a plugin tile always goes through it). The plugin imports this add-on. -->
<addon id="script.aniverse" name="AniVerse" version="1.0.0" provider-name="AniVerse">
  <requires>
    <import addon="xbmc.python" version="3.0.1"/>
  </requires>
  <extension point="xbmc.python.script" library="launcher.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Opens AniVerse</summary>
    <description lang="en_GB">Starts AniVerse. Installed together with AniVerse.</description>
    <platform>all</platform>
    <license>Personal use</license>
    <assets>
      <icon>aniverse-icon.png</icon>
      <fanart>fanart.png</fanart>
    </assets>
  </extension>
</addon>
