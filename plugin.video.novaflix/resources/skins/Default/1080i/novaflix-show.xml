<?xml version="1.0" encoding="UTF-8"?>
<!-- M12 show page. Window properties from gui/show.py: title alt plot meta art dark poster genres
     dub has_related related_label season_label play_label favourite_label favourited episodes_title no_episodes loading
     avail avail_line (availability of the Play episode, gui/show.py). -->
<window>
  <defaultcontrol>500</defaultcontrol>
  <animation effect="fade" start="0" end="100" time="200">WindowOpen</animation>
  <animation effect="fade" start="100" end="0" time="150">WindowClose</animation>
  <controls>
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture colordiffuse="FF02050D">av-white.png</texture>
    </control>
    <!-- banner hero -->
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>660</height>
      <aspectratio>scale</aspectratio><fadetime>300</fadetime>
      <texture background="true">$INFO[Window.Property(art)]</texture>
    </control>
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>660</height>
      <texture colordiffuse="9902050D">av-white.png</texture>
      <visible>!String.IsEmpty(Window.Property(dark))</visible>
    </control>
    <control type="image">
      <left>0</left><top>0</top><width>1400</width><height>660</height>
      <texture>av-fade-left.png</texture>
    </control>
    <control type="image">
      <left>0</left><top>380</top><width>1920</width><height>282</height>
      <texture>av-fade-bottom.png</texture>
    </control>
    <!-- poster -->
    <control type="image">
      <left>80</left><top>200</top><width>240</width><height>360</height>
      <aspectratio>scale</aspectratio>
      <texture diffuse="av-mask-poster.png" fallback="av-placeholder.png" background="true">$INFO[Window.Property(poster)]</texture>
    </control>
    <!-- text -->
    <control type="label">
      <left>360</left><top>190</top><width>1300</width><height>80</height>
      <font>font_MainMenu</font><textcolor>FFF5F7FF</textcolor>
      <label>$INFO[Window.Property(title)]</label>
    </control>
    <control type="label">
      <left>360</left><top>268</top><width>1300</width><height>44</height>
      <font>font13</font><textcolor>FFA8B5D1</textcolor>
      <label>$INFO[Window.Property(alt)]</label>
    </control>
    <control type="group">
      <left>360</left><top>318</top>
      <control type="image">
        <width>110</width><height>36</height>
        <texture border="16" colordiffuse="FF5B1FD6">av-pill.png</texture>
        <visible>!String.IsEmpty(Window.Property(dub))</visible>
      </control>
      <control type="label">
        <width>110</width><height>36</height><align>center</align><aligny>center</aligny>
        <font>font_flag</font><textcolor>FFFFFFFF</textcolor>
        <label>$INFO[Window.Property(dub)]</label>
      </control>
      <control type="label">
        <left>130</left><width>1100</width><height>36</height><aligny>center</aligny>
        <font>font12</font><textcolor>FF00A6D6</textcolor>
        <label>$INFO[Window.Property(meta)]$INFO[Window.Property(genres), · ]$INFO[Window.Property(mal), · ]</label>
      </control>
    </control>
    <control type="textbox">
      <left>360</left><top>370</top><width>1100</width><height>140</height>
      <font>font12</font><textcolor>FFD6DEF5</textcolor>
      <label>$INFO[Window.Property(plot)]</label>
    </control>
    <!-- buttons -->
    <control type="grouplist">
      <left>360</left><top>530</top><width>1500</width><height>90</height>
      <orientation>horizontal</orientation><itemgap>24</itemgap>
      <ondown>510</ondown>
      <control type="button" id="500">
        <width>340</width><height>80</height>
        <font>font30_title</font><align>center</align><aligny>center</aligny>
        <textcolor>FFFFFFFF</textcolor><focusedcolor>FFFFFFFF</focusedcolor>
        <texturefocus border="20">av-gradient.png</texturefocus>
        <texturenofocus border="20" colordiffuse="CC5B1FD6">av-gradient.png</texturenofocus>
        <label>$INFO[Window.Property(play_label)]</label>
        <animation effect="zoom" start="100" end="105" time="120" center="auto">Focus</animation>
      </control>
      <control type="button" id="501">
        <width>420</width><height>80</height>
        <font>font30_title</font><align>center</align><aligny>center</aligny>
        <textcolor>FFA8B5D1</textcolor><focusedcolor>FFFFFFFF</focusedcolor>
        <texturefocus border="20" colordiffuse="FF0663CC">av-round.png</texturefocus>
        <texturenofocus border="20" colordiffuse="B3070F1F">av-round.png</texturenofocus>
        <label>$INFO[Window.Property(favourite_label)]</label>
        <animation effect="zoom" start="100" end="105" time="120" center="auto">Focus</animation>
      </control>
      <control type="button" id="502">
        <width>340</width><height>80</height>
        <font>font30_title</font><align>center</align><aligny>center</aligny>
        <textcolor>FFA8B5D1</textcolor><focusedcolor>FFFFFFFF</focusedcolor>
        <texturefocus border="20" colordiffuse="FF0663CC">av-round.png</texturefocus>
        <texturenofocus border="20" colordiffuse="B3070F1F">av-round.png</texturenofocus>
        <label>$INFO[Window.Property(related_label)]</label>
        <visible>!String.IsEmpty(Window.Property(has_related))</visible>
        <animation effect="zoom" start="100" end="105" time="120" center="auto">Focus</animation>
      </control>
      <control type="button" id="503">
        <width>300</width><height>80</height>
        <font>font30_title</font><align>center</align><aligny>center</aligny>
        <textcolor>FFA8B5D1</textcolor><focusedcolor>FFFFFFFF</focusedcolor>
        <texturefocus border="20" colordiffuse="FF0663CC">av-round.png</texturefocus>
        <texturenofocus border="20" colordiffuse="B3070F1F">av-round.png</texturenofocus>
        <label>$INFO[Window.Property(season_label)]</label>
        <visible>!String.IsEmpty(Window.Property(season_label))</visible>
        <animation effect="zoom" start="100" end="105" time="120" center="auto">Focus</animation>
      </control>
    </control>
    <!-- availability of the Play episode -->
    <control type="image">
      <left>360</left><top>630</top><width>12</width><height>12</height>
      <texture colordiffuse="FF00A6D6">av-dot.png</texture>
      <visible>String.IsEqual(Window.Property(avail),available)</visible>
    </control>
    <control type="image">
      <left>360</left><top>630</top><width>12</width><height>12</height>
      <texture colordiffuse="FFF5B04F">av-dot.png</texture>
      <visible>String.IsEqual(Window.Property(avail),upcoming)</visible>
    </control>
    <control type="image">
      <left>360</left><top>630</top><width>12</width><height>12</height>
      <texture colordiffuse="FF4A72D9">av-dot.png</texture>
      <visible>String.IsEqual(Window.Property(avail),sub_only)</visible>
    </control>
    <control type="image">
      <left>360</left><top>630</top><width>12</width><height>12</height>
      <texture colordiffuse="FF8B3FE0">av-dot.png</texture>
      <visible>String.IsEqual(Window.Property(avail),unavailable)</visible>
    </control>
    <control type="image">
      <left>360</left><top>630</top><width>12</width><height>12</height>
      <texture colordiffuse="FF7F8CAD">av-dot.png</texture>
      <visible>String.IsEqual(Window.Property(avail),unknown)</visible>
    </control>
    <control type="image">
      <left>360</left><top>630</top><width>12</width><height>12</height>
      <texture colordiffuse="FF7F8CAD">av-dot.png</texture>
      <visible>String.IsEqual(Window.Property(avail),checking)</visible>
    </control>
    <control type="label">
      <left>382</left><top>618</top><width>1300</width><height>36</height><aligny>center</aligny>
      <font>font12</font><textcolor>FFD6DEF5</textcolor>
      <label>$INFO[Window.Property(avail_line)]</label>
    </control>
    <!-- episodes -->
    <control type="label">
      <left>80</left><top>660</top><width>800</width><height>50</height>
      <font>font30_title</font><textcolor>FFF5F7FF</textcolor>
      <label>$INFO[Window.Property(episodes_title)]</label>
    </control>
    <control type="label">
      <left>80</left><top>720</top><width>1700</width><height>50</height>
      <font>font13</font><textcolor>FFA8B5D1</textcolor>
      <label>$INFO[Window.Property(no_episodes)]</label>
    </control>
    <control type="list" id="510">
      <left>60</left><top>715</top><width>1860</width><height>350</height>
      <orientation>horizontal</orientation>
      <onup>500</onup>
      <scrolltime tween="quadratic" easing="out">200</scrolltime>
      <itemlayout width="400" height="350">
        <control type="image">
          <left>20</left><top>20</top><width>360</width><height>203</height>
          <aspectratio>scale</aspectratio>
          <texture diffuse="av-mask-wide.png" fallback="av-placeholder.png" background="true">$INFO[ListItem.Art(thumb)]</texture>
        </control>
        <control type="image">
          <left>20</left><top>20</top><width>360</width><height>203</height>
          <texture border="14" colordiffuse="404A58D9">av-round-border.png</texture>
        </control>
        <control type="image">
          <left>336</left><top>32</top><width>36</width><height>36</height>
          <texture colordiffuse="FF00A6D6">av-icon-check_circle.png</texture>
          <visible>String.IsEqual(ListItem.Property(watched),true)</visible>
        </control>
        <control type="progress">
          <left>34</left><top>205</top><width>332</width><height>8</height>
          <info>ListItem.PercentPlayed</info>
          <texturebg border="4" colordiffuse="FF111B33">av-progress.png</texturebg>
          <midtexture border="4" colordiffuse="FF8B3FE0">av-progress.png</midtexture>
          <visible>Integer.IsGreater(ListItem.PercentPlayed,0)</visible>
        </control>
        <control type="label">
          <left>20</left><top>232</top><width>360</width><height>40</height>
          <font>font13</font><textcolor>FFF5F7FF</textcolor>
          <label>$INFO[ListItem.Label]</label>
        </control>
        <control type="image">
          <left>20</left><top>282</top><width>12</width><height>12</height>
          <texture colordiffuse="FF00A6D6">av-dot.png</texture>
          <visible>String.IsEqual(ListItem.Property(avail),available)</visible>
        </control>
        <control type="image">
          <left>20</left><top>282</top><width>12</width><height>12</height>
          <texture colordiffuse="FFF5B04F">av-dot.png</texture>
          <visible>String.IsEqual(ListItem.Property(avail),upcoming)</visible>
        </control>
        <control type="image">
          <left>20</left><top>282</top><width>12</width><height>12</height>
          <texture colordiffuse="FF4A72D9">av-dot.png</texture>
          <visible>String.IsEqual(ListItem.Property(avail),sub_only)</visible>
        </control>
        <control type="image">
          <left>20</left><top>282</top><width>12</width><height>12</height>
          <texture colordiffuse="FF8B3FE0">av-dot.png</texture>
          <visible>String.IsEqual(ListItem.Property(avail),unavailable)</visible>
        </control>
        <control type="image">
          <left>20</left><top>282</top><width>12</width><height>12</height>
          <texture colordiffuse="FF7F8CAD">av-dot.png</texture>
          <visible>String.IsEqual(ListItem.Property(avail),unknown)</visible>
        </control>
        <control type="image">
          <left>20</left><top>282</top><width>12</width><height>12</height>
          <texture colordiffuse="FF7F8CAD">av-dot.png</texture>
          <visible>String.IsEqual(ListItem.Property(avail),checking)</visible>
        </control>
        <control type="label">
          <left>20</left><top>272</top><width>360</width><height>32</height>
          <font>font12</font><textcolor>FFA8B5D1</textcolor>
          <label>$INFO[ListItem.Label2]</label>
          <visible>String.IsEmpty(ListItem.Property(avail))</visible>
        </control>
        <control type="label">
          <left>40</left><top>272</top><width>340</width><height>32</height>
          <font>font12</font><textcolor>FFA8B5D1</textcolor>
          <label>$INFO[ListItem.Label2]</label>
          <visible>!String.IsEmpty(ListItem.Property(avail))</visible>
        </control>
        <control type="label">
          <left>20</left><top>304</top><width>360</width><height>32</height>
          <font>font12</font><textcolor>FF8A93AD</textcolor>
          <label>$INFO[ListItem.Property(note)]</label>
        </control>
      </itemlayout>
      <focusedlayout width="400" height="350">
        <control type="group">
          <animation effect="zoom" start="100" end="106" time="120" center="200,120">Focus</animation>
          <control type="image">
            <left>-10</left><top>-10</top><width>420</width><height>263</height>
            <texture border="40" colordiffuse="FF00A6D6">av-glow.png</texture>
          </control>
          <control type="image">
            <left>20</left><top>20</top><width>360</width><height>203</height>
            <aspectratio>scale</aspectratio>
            <texture diffuse="av-mask-wide.png" fallback="av-placeholder.png" background="true">$INFO[ListItem.Art(thumb)]</texture>
          </control>
          <control type="image">
            <left>20</left><top>20</top><width>360</width><height>203</height>
            <texture border="14" colordiffuse="FF00A6D6">av-round-border.png</texture>
          </control>
          <control type="image">
            <left>336</left><top>32</top><width>36</width><height>36</height>
            <texture colordiffuse="FF00A6D6">av-icon-check_circle.png</texture>
            <visible>String.IsEqual(ListItem.Property(watched),true)</visible>
          </control>
          <control type="progress">
            <left>34</left><top>205</top><width>332</width><height>8</height>
            <info>ListItem.PercentPlayed</info>
            <texturebg border="4" colordiffuse="FF111B33">av-progress.png</texturebg>
            <midtexture border="4" colordiffuse="FF8B3FE0">av-progress.png</midtexture>
            <visible>Integer.IsGreater(ListItem.PercentPlayed,0)</visible>
          </control>
        </control>
        <control type="label">
          <left>20</left><top>232</top><width>360</width><height>40</height>
          <font>font13</font><textcolor>FFFFFFFF</textcolor><scroll>true</scroll>
          <label>$INFO[ListItem.Label]</label>
        </control>
        <control type="image">
          <left>20</left><top>282</top><width>12</width><height>12</height>
          <texture colordiffuse="FF00A6D6">av-dot.png</texture>
          <visible>String.IsEqual(ListItem.Property(avail),available)</visible>
        </control>
        <control type="image">
          <left>20</left><top>282</top><width>12</width><height>12</height>
          <texture colordiffuse="FFF5B04F">av-dot.png</texture>
          <visible>String.IsEqual(ListItem.Property(avail),upcoming)</visible>
        </control>
        <control type="image">
          <left>20</left><top>282</top><width>12</width><height>12</height>
          <texture colordiffuse="FF4A72D9">av-dot.png</texture>
          <visible>String.IsEqual(ListItem.Property(avail),sub_only)</visible>
        </control>
        <control type="image">
          <left>20</left><top>282</top><width>12</width><height>12</height>
          <texture colordiffuse="FF8B3FE0">av-dot.png</texture>
          <visible>String.IsEqual(ListItem.Property(avail),unavailable)</visible>
        </control>
        <control type="image">
          <left>20</left><top>282</top><width>12</width><height>12</height>
          <texture colordiffuse="FF7F8CAD">av-dot.png</texture>
          <visible>String.IsEqual(ListItem.Property(avail),unknown)</visible>
        </control>
        <control type="image">
          <left>20</left><top>282</top><width>12</width><height>12</height>
          <texture colordiffuse="FF7F8CAD">av-dot.png</texture>
          <visible>String.IsEqual(ListItem.Property(avail),checking)</visible>
        </control>
        <control type="label">
          <left>20</left><top>272</top><width>360</width><height>32</height>
          <font>font12</font><textcolor>FFD6DEF5</textcolor>
          <label>$INFO[ListItem.Label2]</label>
          <visible>String.IsEmpty(ListItem.Property(avail))</visible>
        </control>
        <control type="label">
          <left>40</left><top>272</top><width>340</width><height>32</height>
          <font>font12</font><textcolor>FFD6DEF5</textcolor>
          <label>$INFO[ListItem.Label2]</label>
          <visible>!String.IsEmpty(ListItem.Property(avail))</visible>
        </control>
        <control type="label">
          <left>20</left><top>304</top><width>360</width><height>32</height>
          <font>font12</font><textcolor>FF8A93AD</textcolor>
          <label>$INFO[ListItem.Property(note)]</label>
        </control>
      </focusedlayout>
    </control>
    <!-- loading -->
    <control type="label">
      <left>360</left><top>500</top><width>1200</width><height>60</height>
      <font>font30_title</font><textcolor>FFA8B5D1</textcolor>
      <label>...</label>
      <visible>!String.IsEmpty(Window.Property(loading))</visible>
    </control>
  </controls>
</window>
