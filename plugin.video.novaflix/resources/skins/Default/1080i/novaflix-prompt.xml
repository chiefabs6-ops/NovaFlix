    <!-- gen:prompt -->
<control type="image"><left>0</left><top>400</top><width>1920</width><height>680</height><texture>av-shade-bottom.png</texture><visible>!String.IsEmpty(Window.Property(text))</visible></control>
<control type="label"><left>1064</left><top>672</top><width>760</width><height>40</height><font>font12</font><textcolor>FF35CDF5</textcolor><aligny>center</aligny><label>[B]$ADDON[plugin.video.novaflix 30533][/B]</label><visible>!String.IsEmpty(Window.Property(title))</visible></control>
<control type="group"><left>0</left><top>0</top><width>1920</width><height>1080</height><visible>!String.IsEmpty(Window.Property(title)) + !String.IsEmpty(Window.Property(art))</visible>
<control type="image"><left>1064</left><top>722</top><width>300</width><height>169</height><texture diffuse="av-mask-wide10.png" background="true">$INFO[Window.Property(art)]</texture><aspectratio>scale</aspectratio></control>
