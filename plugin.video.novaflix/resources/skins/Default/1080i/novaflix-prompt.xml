<?xml version="1.0" encoding="UTF-8"?>
<!-- Skip intro/ending and Up next prompt over playing video. Properties set from kodi/prompt.py:
     text, button, button2 (Up next only: End episode, left of Choose source).
     Text on top, buttons underneath. Absolute left/top only, so every skin lays it out the same. -->
<window>
  <defaultcontrol always="true">9000</defaultcontrol>
  <zorder>1</zorder>
  <controls>
    <control type="group">
      <left>1300</left><top>790</top><width>560</width><height>146</height>
      <!-- one button: panel behind the right-hand button only -->
      <control type="image">
        <left>260</left><top>0</top><width>300</width><height>146</height>
        <texture border="20" colordiffuse="E0070F1F">av-round.png</texture>
        <visible>!String.IsEmpty(Window.Property(text)) + String.IsEmpty(Window.Property(button2))</visible>
      </control>
      <control type="label">
        <left>270</left><top>10</top><width>280</width><height>44</height>
        <font>font13</font><textcolor>FFFFFFFF</textcolor>
        <align>center</align><aligny>center</aligny>
        <label>$INFO[Window.Property(text)]</label>
        <visible>String.IsEmpty(Window.Property(button2))</visible>
      </control>
      <!-- two buttons: panel across both -->
      <control type="image">
        <left>0</left><top>0</top><width>560</width><height>146</height>
        <texture border="20" colordiffuse="E0070F1F">av-round.png</texture>
        <visible>!String.IsEmpty(Window.Property(button2))</visible>
      </control>
      <control type="label">
        <left>10</left><top>10</top><width>540</width><height>44</height>
        <font>font13</font><textcolor>FFFFFFFF</textcolor>
        <align>center</align><aligny>center</aligny>
        <label>$INFO[Window.Property(text)]</label>
        <visible>!String.IsEmpty(Window.Property(button2))</visible>
      </control>
      <control type="button" id="9001">
        <left>20</left><top>64</top><width>250</width><height>62</height>
        <font>font13</font><align>center</align><aligny>center</aligny>
        <textcolor>FFA8B5D1</textcolor><focusedcolor>FFFFFFFF</focusedcolor>
        <texturefocus border="20">av-gradient.png</texturefocus>
        <texturenofocus border="20" colordiffuse="FF0c1730">av-round.png</texturenofocus>
        <label>$INFO[Window.Property(button2)]</label>
        <onright>9000</onright>
        <visible>!String.IsEmpty(Window.Property(button2))</visible>
      </control>
      <control type="button" id="9000">
        <left>280</left><top>64</top><width>260</width><height>62</height>
        <font>font13</font><align>center</align><aligny>center</aligny>
        <textcolor>FFA8B5D1</textcolor><focusedcolor>FFFFFFFF</focusedcolor>
        <texturefocus border="20">av-gradient.png</texturefocus>
        <texturenofocus border="20" colordiffuse="FF0c1730">av-round.png</texturenofocus>
        <label>$INFO[Window.Property(button)]</label>
        <onleft>9001</onleft>
      </control>
    </control>
  </controls>
</window>
