<?xml version="1.0" encoding="UTF-8"?>
<!-- Skip intro/ending and Up next prompt over playing video. Properties set from kodi/prompt.py:
     text, button, button2 (Up next only: End episode, left of Choose source).
     Generated: tools/gen_layouts.py. Absolute left/top only, so every skin lays it out the same. -->
<window>
  <defaultcontrol always="true">9000</defaultcontrol>
  <zorder>1</zorder>
  <controls>
    <!-- gen:prompt -->
<control type="image"><left>0</left><top>560</top><width>1920</width><height>520</height><texture>av-shade-bottom.png</texture><visible>!String.IsEmpty(Window.Property(text))</visible></control>
<control type="label"><left>1196</left><top>850</top><width>628</width><height>60</height><font>font30_title</font><textcolor>FFFFFFFF</textcolor><align>right</align><aligny>center</aligny><label>$INFO[Window.Property(text)]</label><visible>!String.IsEmpty(Window.Property(text))</visible></control>
<control type="button" id="9001"><left>1196</left><top>930</top><width>300</width><height>78</height><font>font30_title</font><align>center</align><aligny>center</aligny><textoffsetx>44</textoffsetx><textcolor>FFFFFFFF</textcolor><focusedcolor>FFFFFFFF</focusedcolor><texturefocus border="39">av-btn-secondary-focus.png</texturefocus><texturenofocus border="39">av-btn-secondary.png</texturenofocus><label>$INFO[Window.Property(button2)]</label><onright>9000</onright><animation effect="zoom" start="100" end="105" time="150" center="auto">Focus</animation><visible>!String.IsEmpty(Window.Property(button2))</visible></control>
<control type="button" id="9000"><left>1504</left><top>930</top><width>320</width><height>78</height><font>font30_title</font><align>center</align><aligny>center</aligny><textoffsetx>44</textoffsetx><textcolor>FF05070A</textcolor><focusedcolor>FF05070A</focusedcolor><texturefocus border="39">av-btn-primary-focus.png</texturefocus><texturenofocus border="39">av-btn-primary.png</texturenofocus><label>$INFO[Window.Property(button)]</label><onleft>9001</onleft><animation effect="zoom" start="100" end="105" time="150" center="auto">Focus</animation><animation effect="slide" start="0,0" end="0,-858" time="0" condition="String.IsEmpty(Window.Property(button2)) + String.IsEmpty(Window.Property(text))">Conditional</animation></control>
    <!-- /gen:prompt -->
  </controls>
</window>
