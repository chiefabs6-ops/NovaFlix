<?xml version="1.0" encoding="UTF-8"?>
<!-- M12 styled yes/no. Properties: heading, message, yes, no (gui/dialogs.py). -->
<window>
  <defaultcontrol always="true">700</defaultcontrol>
  <animation effect="fade" start="0" end="100" time="150">WindowOpen</animation>
  <animation effect="fade" start="100" end="0" time="120">WindowClose</animation>
  <controls>
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture colordiffuse="B302050D">av-white.png</texture>
    </control>
    <control type="group">
      <left>510</left><top>320</top>
      <control type="image">
        <left>-40</left><top>-40</top><width>980</width><height>520</height>
        <texture border="40" colordiffuse="405B1FD6">av-glow.png</texture>
      </control>
      <control type="image">
        <width>900</width><height>440</height>
        <texture border="20" colordiffuse="FF070F1F">av-round.png</texture>
      </control>
      <control type="image">
        <width>900</width><height>440</height>
        <texture border="20" colordiffuse="404A58D9">av-round-border.png</texture>
      </control>
      <control type="label">
        <left>50</left><top>36</top><width>800</width><height>56</height>
        <font>font36_title</font><textcolor>FFF5F7FF</textcolor>
        <label>$INFO[Window.Property(heading)]</label>
      </control>
      <control type="textbox">
        <left>50</left><top>110</top><width>800</width><height>180</height>
        <font>font13</font><textcolor>FFA8B5D1</textcolor>
        <label>$INFO[Window.Property(message)]</label>
      </control>
      <control type="button" id="700">
        <left>420</left><top>320</top><width>200</width><height>80</height>
        <font>font30_title</font><align>center</align><aligny>center</aligny>
        <textcolor>FFA8B5D1</textcolor><focusedcolor>FFFFFFFF</focusedcolor>
        <texturefocus border="20">av-gradient.png</texturefocus>
        <texturenofocus border="20" colordiffuse="FF0c1730">av-round.png</texturenofocus>
        <label>$INFO[Window.Property(yes)]</label>
        <onleft>701</onleft><onright>701</onright>
      </control>
      <control type="button" id="701">
        <left>650</left><top>320</top><width>200</width><height>80</height>
        <font>font30_title</font><align>center</align><aligny>center</aligny>
        <textcolor>FFA8B5D1</textcolor><focusedcolor>FFFFFFFF</focusedcolor>
        <texturefocus border="20">av-gradient.png</texturefocus>
        <texturenofocus border="20" colordiffuse="FF0c1730">av-round.png</texturenofocus>
        <label>$INFO[Window.Property(no)]</label>
        <onleft>700</onleft><onright>700</onright>
      </control>
    </control>
  </controls>
</window>
