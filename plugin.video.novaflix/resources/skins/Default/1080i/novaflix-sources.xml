<?xml version="1.0" encoding="UTF-8"?>
<!-- M12 styled source list. Items from gui/items.py: label, label2, Property(status|note). -->
<window>
  <animation effect="fade" start="0" end="100" time="150">WindowOpen</animation>
  <animation effect="fade" start="100" end="0" time="120">WindowClose</animation>
  <controls>
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture colordiffuse="CC02050D">av-white.png</texture>
    </control>
    <control type="group">
      <left>260</left><top>110</top>
      <control type="image">
        <left>-40</left><top>-40</top><width>1480</width><height>940</height>
        <texture border="40" colordiffuse="335B1FD6">av-glow.png</texture>
      </control>
      <control type="image">
        <width>1400</width><height>860</height>
        <texture border="20" colordiffuse="FF070F1F">av-round.png</texture>
      </control>
      <control type="image">
        <width>1400</width><height>860</height>
        <texture border="20" colordiffuse="404A58D9">av-round-border.png</texture>
      </control>
      <control type="label">
        <left>50</left><top>30</top><width>1300</width><height>60</height>
        <font>font36_title</font><textcolor>FFF5F7FF</textcolor>
        <label>$INFO[Window.Property(heading)]</label>
      </control>
      <control type="list" id="600">
        <left>30</left><top>110</top><width>1340</width><height>720</height>
        <orientation>vertical</orientation>
        <scrolltime tween="quadratic" easing="out">160</scrolltime>
        <onleft>600</onleft><onright>600</onright>
        <itemlayout height="112" width="1340">
          <control type="image">
            <left>20</left><top>30</top><width>8</width><height>52</height>
            <texture border="3" colordiffuse="FF00A6D6">av-pill.png</texture>
            <visible>String.IsEqual(ListItem.Property(status),ready)</visible>
          </control>
          <control type="image">
            <left>20</left><top>30</top><width>8</width><height>52</height>
            <texture border="3" colordiffuse="FF8B3FE0">av-pill.png</texture>
            <visible>String.IsEqual(ListItem.Property(status),download)</visible>
          </control>
          <control type="image">
            <left>20</left><top>30</top><width>8</width><height>52</height>
            <texture border="3" colordiffuse="FFFF4D6D">av-pill.png</texture>
            <visible>String.IsEqual(ListItem.Property(status),blocked)</visible>
          </control>
          <control type="label">
            <left>48</left><top>14</top><width>1250</width><height>46</height>
            <font>font13</font><textcolor>FFF5F7FF</textcolor>
            <label>$INFO[ListItem.Label]</label>
            <visible>!String.IsEqual(ListItem.Property(status),action)</visible>
          </control>
          <control type="label">
            <left>48</left><top>60</top><width>1250</width><height>38</height>
            <font>font12</font><textcolor>FFA8B5D1</textcolor>
            <label>$INFO[ListItem.Label2]</label>
          </control>
          <control type="label">
            <left>48</left><top>30</top><width>1250</width><height>52</height>
            <font>font13</font><textcolor>FF8B3FE0</textcolor>
            <label>$INFO[ListItem.Label]</label>
            <visible>String.IsEqual(ListItem.Property(status),action)</visible>
          </control>
        </itemlayout>
        <focusedlayout height="112" width="1340">
          <control type="image">
            <left>0</left><top>4</top><width>1340</width><height>104</height>
            <texture border="20" colordiffuse="1A00A6D6">av-round.png</texture>
          </control>
          <control type="image">
            <left>0</left><top>4</top><width>1340</width><height>104</height>
            <texture border="20" colordiffuse="FF00A6D6">av-round-border.png</texture>
          </control>
          <control type="image">
            <left>20</left><top>30</top><width>8</width><height>52</height>
            <texture border="3" colordiffuse="FF00A6D6">av-pill.png</texture>
            <visible>String.IsEqual(ListItem.Property(status),ready)</visible>
          </control>
          <control type="image">
            <left>20</left><top>30</top><width>8</width><height>52</height>
            <texture border="3" colordiffuse="FF8B3FE0">av-pill.png</texture>
            <visible>String.IsEqual(ListItem.Property(status),download)</visible>
          </control>
          <control type="image">
            <left>20</left><top>30</top><width>8</width><height>52</height>
            <texture border="3" colordiffuse="FFFF4D6D">av-pill.png</texture>
            <visible>String.IsEqual(ListItem.Property(status),blocked)</visible>
          </control>
          <control type="label">
            <left>48</left><top>14</top><width>1250</width><height>46</height>
            <font>font13</font><textcolor>FFFFFFFF</textcolor><scroll>true</scroll>
            <label>$INFO[ListItem.Label]</label>
            <visible>!String.IsEqual(ListItem.Property(status),action)</visible>
          </control>
          <control type="label">
            <left>48</left><top>60</top><width>1250</width><height>38</height>
            <font>font12</font><textcolor>FFD6DEF5</textcolor>
            <label>$INFO[ListItem.Label2]</label>
          </control>
          <control type="label">
            <left>48</left><top>30</top><width>1250</width><height>52</height>
            <font>font13</font><textcolor>FFFFFFFF</textcolor>
            <label>$INFO[ListItem.Label]</label>
            <visible>String.IsEqual(ListItem.Property(status),action)</visible>
          </control>
        </focusedlayout>
      </control>
    </control>
  </controls>
</window>
