<?xml version="1.0" encoding="UTF-8"?>
<!-- M12 styled download progress. Properties: heading, message, cancel; control 710 = bar. -->
<window>
  <defaultcontrol always="true">711</defaultcontrol>
  <animation effect="fade" start="0" end="100" time="150">WindowOpen</animation>
  <controls>
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture colordiffuse="B302050D">av-white.png</texture>
    </control>
    <control type="group">
      <left>460</left><top>340</top>
      <control type="image">
        <width>1000</width><height>400</height>
        <texture border="20" colordiffuse="FF070F1F">av-round.png</texture>
      </control>
      <control type="image">
        <width>1000</width><height>400</height>
        <texture border="20" colordiffuse="404A58D9">av-round-border.png</texture>
      </control>
      <control type="label">
        <left>50</left><top>36</top><width>900</width><height>56</height>
        <font>font36_title</font><textcolor>FFF5F7FF</textcolor>
        <label>$INFO[Window.Property(heading)]</label>
      </control>
      <control type="label">
        <left>50</left><top>110</top><width>900</width><height>44</height>
        <font>font13</font><textcolor>FFA8B5D1</textcolor>
        <label>$INFO[Window.Property(message)]</label>
      </control>
      <control type="progress" id="710">
        <left>50</left><top>180</top><width>900</width><height>14</height>
        <texturebg border="4" colordiffuse="FF111B33">av-progress.png</texturebg>
        <midtexture border="4" colordiffuse="FF8B3FE0">av-progress.png</midtexture>
      </control>
      <control type="button" id="711">
        <left>400</left><top>270</top><width>200</width><height>80</height>
        <font>font30_title</font><align>center</align><aligny>center</aligny>
        <textcolor>FFA8B5D1</textcolor><focusedcolor>FFFFFFFF</focusedcolor>
        <texturefocus border="20">av-gradient.png</texturefocus>
        <texturenofocus border="20" colordiffuse="FF0c1730">av-round.png</texturenofocus>
        <label>$INFO[Window.Property(cancel)]</label>
      </control>
    </control>
  </controls>
</window>
