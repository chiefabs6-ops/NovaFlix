<?xml version="1.0" encoding="UTF-8"?>
<!-- QR screen (phone search): QR code, address, code, countdown. Properties set from login_dialog.py. -->
<window>
  <defaultcontrol always="true">9000</defaultcontrol>
  <controls>
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture colordiffuse="E0000000">novaflix-white.png</texture>
    </control>
    <control type="group">
      <left>310</left><top>190</top>
      <control type="image">
        <width>1300</width><height>700</height>
        <texture colordiffuse="FF1E1B2E">novaflix-white.png</texture>
      </control>
      <control type="label">
        <left>60</left><top>40</top><width>1180</width><height>60</height>
        <font>font30_title</font><textcolor>FFFFFFFF</textcolor>
        <label>$INFO[Window.Property(heading)]</label>
      </control>
      <control type="image">
        <left>60</left><top>130</top><width>440</width><height>440</height>
        <aspectratio>keep</aspectratio>
        <texture>$INFO[Window.Property(qr)]</texture>
      </control>
      <control type="textbox">
        <left>560</left><top>130</top><width>680</width><height>170</height>
        <font>font13</font><textcolor>FFDDDDDD</textcolor>
        <label>$INFO[Window.Property(text)]</label>
      </control>
      <control type="label">
        <left>560</left><top>300</top><width>680</width><height>50</height>
        <font>font13</font><textcolor>FFFFC857</textcolor>
        <label>$INFO[Window.Property(url)]</label>
      </control>
      <control type="label">
        <left>560</left><top>360</top><width>680</width><height>110</height>
        <font>font52_title</font><textcolor>FFFFFFFF</textcolor>
        <label>$INFO[Window.Property(code)]</label>
      </control>
      <control type="label">
        <left>560</left><top>490</top><width>680</width><height>50</height>
        <font>font13</font><textcolor>FF9E9E9E</textcolor>
        <label>$INFO[Window.Property(status)]</label>
      </control>
      <control type="button" id="9000">
        <left>560</left><top>580</top><width>300</width><height>70</height>
        <font>font13</font><align>center</align><aligny>center</aligny>
        <textcolor>FFFFFFFF</textcolor><focusedcolor>FF000000</focusedcolor>
        <texturefocus colordiffuse="FFFFC857">novaflix-white.png</texturefocus>
        <texturenofocus colordiffuse="FF3A3550">novaflix-white.png</texturenofocus>
        <label>$ADDON[plugin.video.novaflix 30122]</label>
      </control>
    </control>
  </controls>
</window>
