        <setting id="min_resolution" type="integer" label="30166">
          <level>0</level>
          <default>0</default>
          <constraints>
            <options>
              <option label="30167">0</option>
              <option label="30172">1</option>
              <option label="30173">2</option>
              <option label="30174">3</option>
              <option label="30175">4</option>
            </options>
          </constraints>
